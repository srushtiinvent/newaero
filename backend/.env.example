# Postgres connection — from Neon/Supabase (or wherever you're hosting it)
DATABASE_URL=postgresql://your_real_user:your_real_password@your_real_host:5432/your_real_db?schema=public

# Firebase — pick ONE option, not both
# Option A: paste your service account JSON here, as a single escaped-JSON line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project",...}

# Option B (alternative to A): point to the downloaded JSON file instead
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

FIREBASE_STORAGE_BUCKET=your-actual-project.appspot.com

PORT=4000
NODE_ENV=development

# Amadeus for Developers (from developers.amadeus.com, after creating your self-service app)
AMADEUS_API_KEY=your_real_amadeus_api_key
AMADEUS_API_SECRET=your_real_amadeus_api_secret